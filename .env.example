# ============================================================
# TeX_Agent 环境变量配置示例（模板文件）
# 使用方式：cp .env.example .env，然后填入实际值
# 注意：.env 文件不应提交到版本控制，请确保已加入 .gitignore
# ============================================================

# ---- LLM 配置 ----
# 变量名必须与 config/settings.py 中读取的环境变量一致
# 支持 OpenAI、DeepSeek（OpenAI 兼容协议）等任意 LLM 服务

# OpenAI 官方示例：
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# DeepSeek 示例（推荐，性价比高）：
# OPENAI_API_KEY=sk-48ad36e11b0b4f069d8ef785fd63c10f
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# GPT API
OPENAI_API_KEY=sk-MY2CLDPm4PGm5de602xPIsOt3dIGeXEcuDSrIJa7FvMZ7aXD
OPENAI_BASE_URL=https://svip.xty.app/v1
LLM_MODEL=gpt-3.5-turbo

# ---- RAG 配置（可选）----
# RAG_PERSIST_DIR：向量库持久化路径。
#   - 留空（默认）：使用内存模式，进程退出后知识库清空。
#   - 填写路径：知识库持久化到本地，重启后保留。
RAG_PERSIST_DIR=./knowledge_base

# ---- 日志配置 ----
# 可选值：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
