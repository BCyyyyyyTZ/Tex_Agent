# ============================================================
# TeX_Agent 环境变量配置示例（模板文件）
# 使用方式：cp .env.example .env，然后填入实际值
# 注意：.env 文件不应提交到版本控制，请确保已加入 .gitignore
# ============================================================

# ---- LLM 配置 ----
# 变量名必须与 config/settings.py 中读取的环境变量一致
# 支持 OpenAI、DeepSeek（OpenAI 兼容协议）等任意 LLM 服务

# OpenAI 官方示例：
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# DeepSeek 示例（推荐，性价比高）：
# OPENAI_API_KEY=sk-48ad36e11b0b4f069d8ef785fd63c10f
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# GPT API
OPENAI_API_KEY=sk-MY2CLDPm4PGm5de602xPIsOt3dIGeXEcuDSrIJa7FvMZ7aXD
OPENAI_BASE_URL=https://svip.xty.app/v1
LLM_MODEL=gpt-3.5-turbo

# QWEN API，效果不佳
QWEN_API_KEY=sk-23ba118194784871a66dda26a0c54251
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-flash

# Genimi API
GEMINI_API_KEY=AIzaSyANimadBfxFqRrAGbgXMmNpRGcPXPrgMA4
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-3-flash-preview

# ---- RAG 配置----
# RAG_PERSIST_DIR：向量库持久化路径。
#   - 留空（默认）：使用内存模式，进程退出后知识库清空。
#   - 填写路径：知识库持久化到本地，重启后保留。
RAG_PERSIST_DIR=./knowledge_base

# ---- 日志配置 ----
# 可选值：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---- 文档解析导出----
# PARSED_DOC_DIR：Docling 解析结果输出根目录。
#   - 留空（默认）：使用项目内 doc/parsed_doc（相对项目根 Tex_Agent/）。
#   - 相对路径：相对于项目根 Tex_Agent/。
#   - 绝对路径：直接使用该目录。
PARSED_DOC_DIR=./doc/parsed_doc
# 有关大文件解析的旁路配置（见 rag/docling_parse.py）
PAGE_THRESHOLD=30 # 页数 >= 该值走旁路
LARGE_DOC_FORCE_NO_OCR=true
CHUNK_PAGES=20 # 分块拼接旁路中每块最大页数
CHUNK_OVERLAP=1 # 分块拼接旁路中相邻块重叠页数
LARGE_DOC_MAX_PARALLEL=1 # 旁路中 AcceleratorOptions.num_threads 上限（至少为 1）
CHUNK_PARSED_DOC_DIR=../chunk_parsed_doc
