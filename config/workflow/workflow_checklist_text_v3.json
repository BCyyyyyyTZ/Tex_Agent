{
  "_comment": "checklist text review v3: batch-friendly; preflight_inputs uses structured JSON input without LLM",
  "nodes": [
    {
      "node_id": "preflight_inputs",
      "node_type": "tool",
      "tool_name": "preflight_inputs",
      "config": {
        "tool_input": {
          "user_input": "${input}",
          "context_text": "${last_message_content}",
          "workflow_name": "${metadata.workflow}",
