      "condition": null
    },
    {
      "from_node": "parse_thesis_doc",
      "to_node": "checklist_review",
      "condition": null
    },
    {
      "from_node": "load_checklist",
      "to_node": "checklist_review",
      "condition": null
    },
    {
      "from_node": "checklist_review",
      "to_node": "final_delivery",
      "condition": null
    }
  ]
}
