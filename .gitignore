# ============================================================
# TeX_Agent .gitignore
# ============================================================

# ---- 环境变量（含 API Key，绝对不能提交）----
.env

# ---- Python 编译缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 测试与覆盖率缓存 ----
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ---- IDE 配置 ----
.idea/
.vscode/
*.swp
*.swo

# ---- RAG 向量库持久化数据 ----
# 如果你将 RAG_PERSIST_DIR 设置为项目内的路径，确保其在此处被忽略
knowledge_base/
chroma_data/
*.chroma/

# ---- 构建产物 ----
dist/
build/
*.egg-info/

# ---- check.py 工作目录（保留 .gitkeep）----
files/input/*
!files/input/.gitkeep
files/checklist/*
!files/checklist/.gitkeep
files/checked/*
!files/checked/.gitkeep
files/output/*
!files/output/.gitkeep

# ---- 日志文件 ----
*.log
logs/

# Web UI 用户上传文件（各子目录用 .gitkeep 占位）
storage/pdfs/*
!storage/pdfs/.gitkeep
storage/skills/*
!storage/skills/.gitkeep
storage/checklists/*
!storage/checklists/.gitkeep
storage/documents/*
!storage/documents/.gitkeep
storage/

# ---- 运行产物（节点 I/O 样例、JSONL 记忆）----
output/
memory_store/
# RAG 工具集成测试落盘输出（本地查看用）
tests/test_rag/_rag_tool_output/
doc/code_note/

# 关于latex解析的测试内容
tests/test_latex/VaLoRA_TMC